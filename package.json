{
  "name": "@dashkite/genie",
  "version": "0.20.0",
  "description": "Task runner for CoffeeScript",
  "exports": {
    ".": {
      "node": "./build/src/index.js"
    }
  },
  "bin": {
    "genie": "bin/genie"
  },
  "files": [
    "build/src",
    "bin",
    "build/browser/src",
    "build/node/src"
  ],
  "imports": {
    "#genie": "./build/src/index.js",
    "#helpers/*": "./build/src/helpers/*.js"
  },
  "scripts": {
    "build": "scripts/build",
    "test": "scripts/test",
    "release": "genie release"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dashkite/genie.git"
  },
  "keywords": [
    "task runner",
    "task",
    "gulp",
    "grunt"
  ],
  "authors": [
    "Dan Yoder",
    "David Harper"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dashkite/joy": "^0.7.0",
    "@dashkite/kaiko": "^0.3.3",
    "@swc/core": "^1.3.96",
    "chalk": "4.x.x",
    "coffeescript": "2.7.x",
    "commander": "^11.1.0",
    "dayjs": "^1.11.9",
    "fast-glob": "^3.3.1",
    "js-yaml": "^4.1.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@dashkite/amen": "^0.5.0",
    "@dashkite/amen-console": "^0.4.0",
    "@dashkite/assert": "^0.3.0",
    "@dashkite/genie-release": "link:../genie-release",
    "babel-plugin-autocomplete-index": "^0.2.0"
  }
}
